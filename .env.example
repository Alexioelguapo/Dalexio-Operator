# Copy to .env and fill in only what you use. .env is gitignored — never commit keys.
# The mock planner needs none of these.

# Which planner to use: mock | claude | openai | openrouter, or a fallback list like "claude,mock"
DALEXIO_PLANNER=mock
DALEXIO_START_URL=https://www.wikipedia.org

# --- Claude (Anthropic API) ------------------------------------------------
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=
# DALEXIO_CLAUDE_MODEL=claude-opus-5-5
# DALEXIO_CLAUDE_EFFORT=medium
# Server-side refusal fallback (Claude API only; set false for Bedrock/Vertex/Foundry clients)
# DALEXIO_CLAUDE_FALLBACKS=true

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
DALEXIO_OPENAI_MODEL=
# DALEXIO_OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenRouter ------------------------------------------------------------
OPENROUTER_API_KEY=
DALEXIO_OPENROUTER_MODEL=

# --- Browser -----------------------------------------------------------------
# Use a specific Chromium binary instead of Playwright's bundled one.
# DALEXIO_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
